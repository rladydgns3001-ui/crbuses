[Unit]
Description=GRX online gym realtime server (grx-world)
After=network.target

[Service]
WorkingDirectory=/opt/grx-world
Environment=GRX_DB=/opt/grx/grx.db
Environment=WORLD_DATA=/opt/grx-world/data.json
ExecStart=/opt/grx-world/venv/bin/uvicorn app:app --host 127.0.0.1 --port 8110 --workers 1
Restart=always
RestartSec=3
MemoryMax=150M
Nice=5

[Install]
WantedBy=multi-user.target
